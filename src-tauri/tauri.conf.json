{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sheaf",
  "version": "0.1.0",
  "identifier": "io.github.premvarma.sheaf",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sheaf",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:",
      "devCsp": "default-src 'self' ipc: http://ipc.localhost ws://localhost:1420; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "copyright": "Copyright © 2026 Prem Varma",
    "publisher": "Prem Varma",
    "shortDescription": "Fast viewer and editor for Excel workbooks and CSV files",
    "longDescription": "Open, edit and save .xlsx, .xlsm, .xls, .csv and .tsv files without Microsoft Excel. Browse sheets, search, jump to cells, edit values and formulas, and save without losing formatting.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["xlsx"],
        "name": "Excel Workbook",
        "description": "Excel Workbook",
        "role": "Editor",
        "mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
      },
      {
        "ext": ["xlsm"],
        "name": "Excel Macro-Enabled Workbook",
        "description": "Excel Macro-Enabled Workbook",
        "role": "Editor",
        "mimeType": "application/vnd.ms-excel.sheet.macroEnabled.12"
      },
      {
        "ext": ["xls"],
        "name": "Excel 97-2003 Workbook",
        "description": "Excel 97-2003 Workbook",
        "role": "Editor",
        "mimeType": "application/vnd.ms-excel"
      },
      {
        "ext": ["csv"],
        "name": "CSV Document",
        "description": "Comma-separated values",
        "role": "Editor",
        "mimeType": "text/csv"
      },
      {
        "ext": ["tsv"],
        "name": "TSV Document",
        "description": "Tab-separated values",
        "role": "Editor",
        "mimeType": "text/tab-separated-values"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
